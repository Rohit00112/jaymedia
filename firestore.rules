rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 1. Events Catalog (`/events/{slug}`)
    match /events/{slug} {
      allow read: if resource.data.status != 'draft' || isSignedIn();
      allow create, update: if isSignedIn()
        && isNonEmptyString(request.resource.data.title, 2, 160)
        && isNonEmptyString(request.resource.data.category, 2, 120);
      allow delete: if isSignedIn();
    }

    // 2. Contestant Registrations (`/registrations/{userCode}`)
    match /registrations/{userCode} {
      allow read: if isSignedIn();
      allow create: if isNonEmptyString(request.resource.data.userCode, 4, 24)
        && isNonEmptyString(request.resource.data.eventSlug, 1, 100)
        && isNonEmptyString(request.resource.data.name, 2, 100)
        && isNonEmptyString(request.resource.data.phone, 7, 20)
        && request.resource.data.age is int
        && request.resource.data.age >= 4
        && request.resource.data.age <= 40;
      allow update, delete: if isSignedIn();
    }

    // 3. Client Project Inquiries (`/inquiries/{inquiryId}`)
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn();
      allow create: if isNonEmptyString(request.resource.data.fullName, 2, 100)
        && isNonEmptyString(request.resource.data.email, 5, 160)
        && isNonEmptyString(request.resource.data.phone, 7, 20)
        && isNonEmptyString(request.resource.data.message, 5, 2000);
      allow update, delete: if isSignedIn();
    }

    // 4. News & Press Releases (`/news/{slug}`)
    match /news/{slug} {
      allow read: if resource.data.status != 'draft' || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 5. Production Services (`/services/{slug}`)
    match /services/{slug} {
      allow read: if resource.data.status != 'draft' || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 6. Leadership & Team (`/team/{slug}`)
    match /team/{slug} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 7. Gallery Media Vault (`/gallery/{id}`)
    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 8. Site Configuration (`/settings/{docId}`)
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
